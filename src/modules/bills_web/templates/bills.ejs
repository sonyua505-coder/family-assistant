<h1>账单</h1>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<% if (accounts.length === 0) { %>
  <div class="empty">还没有账本。</div>
<% } else { %>

<form class="toolbar" method="get" action="/w/<%= token %>/bills">
  <select name="account_id"><%- opt(accounts, accountId, 'daily') %></select>
  <input type="month" name="month" value="<%= month %>" placeholder="月份">
  <select name="category">
    <option value="">全部分类</option>
    <% categories.forEach(function(c){ %>
      <option value="<%= c %>" <%= c === category ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <select name="type">
    <option value="">收支</option>
    <option value="expense" <%= type === 'expense' ? 'selected' : '' %>>支出</option>
    <option value="income" <%= type === 'income' ? 'selected' : '' %>>收入</option>
  </select>
  <select name="status">
    <option value="">全部状态</option>
    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>待结算</option>
    <option value="settled" <%= status === 'settled' ? 'selected' : '' %>>已结清</option>
  </select>
  <input type="number" name="amount_min" min="0" step="0.01" value="<%= amount_min %>" placeholder="金额≥(元)">
  <input type="number" name="amount_max" min="0" step="0.01" value="<%= amount_max %>" placeholder="金额≤(元)">
  <input type="text" name="participant" value="<%= participant %>" placeholder="参与人">
  <button>筛选</button>
</form>

<p class="muted" style="margin:0 0 14px">
  <a class="btn" href="/w/<%= token %>/stats?account_id=<%= accountId %>">📊 统计</a>
  <a class="btn" href="<%= exportHref %>">⬇️ 导出当前筛选 CSV</a>
  <a class="btn" href="/w/<%= token %>/trash?account_id=<%= accountId %>&kind=daily">🗑️ 回收站</a>
</p>

<% if (mode === 'write') { %>
<div class="card">
  <h2>记一笔</h2>
  <form method="post" action="/w/<%= token %>/bills">
    <input type="hidden" name="account_id" value="<%= accountId %>">
    <div class="toolbar">
      <select name="type">
        <option value="expense">支出</option>
        <option value="income">收入</option>
      </select>
      <input type="number" name="amount" step="0.01" min="0.01" placeholder="金额（元）" required>
      <select name="category">
        <% categories.forEach(function(c){ %><option value="<%= c %>"><%= c %></option><% }) %>
      </select>
      <input type="text" name="note" placeholder="备注">
      <input type="text" name="participants" placeholder="AA参与人，逗号分隔（可选）">
      <input type="date" name="occurred_at">
      <button>记一笔</button>
    </div>
  </form>
</div>
<% } %>

<% if (items.length === 0) { %>
  <div class="empty">暂无账单</div>
<% } else { %>
<div class="table-wrap">
<table class="card-list">
<thead>
<tr><th>日期</th><th>分类</th><th>备注</th><th class="num">金额</th><th>状态</th><th>参与人</th><% if (mode === 'write') { %><th>操作</th><% } %></tr>
</thead>
<tbody>
<% items.forEach(function(b){ %>
<tr>
  <td style="white-space:nowrap" data-label="日期"><%= b.occurred_at %></td>
  <td data-label="分类"><span class="cat cat-<%= b.category %>"><%= b.category %></span></td>
  <td data-label="备注"><%= b.note %></td>
  <td class="num amount <%= b.type === 'income' ? 'income' : 'expense' %>" data-label="金额"><%= b.type === 'income' ? '+' : '-' %><%= comma(b.amountYuan) %></td>
  <td style="white-space:nowrap" data-label="状态"><span class="badge <%= b.status %>"><%= b.status === 'pending' ? '🕐 待结算' : '✅ 已结清' %></span></td>
  <td class="muted" data-label="参与人"><%= b.participantsText %></td>
  <% if (mode === 'write') { %>
  <td class="td-actions">
    <a class="btn icon" href="/w/<%= token %>/bills/<%= b.id %>/edit" title="编辑账单">✏️</a>
	<% if (b.status === 'pending') { %>
      <form class="inline" data-keep method="post" action="/w/<%= token %>/bills/<%= b.id %>/settle">
        <input type="hidden" name="all" value="1">
        <button title="全部参与人已付">✅ 结清</button>
      </form>
    <% } %>
    <form class="inline" data-keep method="post" action="/w/<%= token %>/bills/<%= b.id %>/delete">
      <button class="danger" title="软删除，可回收站恢复">🗑️</button>
    </form>
 
  </td>
  <% } %>
</tr>
<% }) %>
</tbody>
</table>
</div>
<div class="pager">
  <% if (page > 1) { %><a href="<%= pagerHref(page - 1) %>">上一页</a><% } %>
  <span>第 <%= page %> 页 / 共 <%= total %> 条</span>
  <% if (items.length === pageSize) { %><a href="<%= pagerHref(page + 1) %>">下一页</a><% } %>
</div>
<% } %>

<% } %>
