<h1>统计</h1>

<% if (accounts.length === 0) { %>
  <div class="empty">还没有账本。</div>
<% } else { %>

<form class="toolbar" method="get" action="/w/<%= token %>/stats">
  <select name="account_id">
    <% accounts.forEach(function(a){ %>
      <option value="<%= a.id %>" <%= a.id === accountId ? 'selected' : '' %>><%= a.name %></option>
    <% }) %>
  </select>
  <input type="number" name="year" min="2000" max="2100" value="<%= year %>" placeholder="年份">
  <select name="month">
    <option value="">全年</option>
    <% for (let m = 1; m <= 12; m++) { %>
      <option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %>月</option>
    <% } %>
  </select>
  <button>查看</button>
</form>

<div class="stat-row">
  <div class="stat">
    <div class="label">收入</div>
    <div class="value income"><%= income %> 元</div>
  </div>
  <div class="stat">
    <div class="label">支出</div>
    <div class="value expense"><%= expense %> 元</div>
  </div>
  <div class="stat">
    <div class="label">结余</div>
    <div class="value <%= income - expense >= 0 ? 'income' : 'expense' %>"><%= (income - expense).toFixed(income - expense % 1 ? 2 : 0) %> 元</div>
  </div>
</div>

<div class="card">
  <h2>支出分类</h2>
  <% if (byCategory.length === 0) { %><div class="empty">暂无数据</div><% } else { %>
  <% let catMax = 0, catTotal = 0; byCategory.forEach(function(c){ if (c.amount > catMax) catMax = c.amount; catTotal += c.amount; }); %>
  <div class="table-wrap">
  <table>
    <tr><th>分类</th><th class="num">金额</th><th class="num">笔数</th><th style="width:45%">占比</th></tr>
    <% byCategory.forEach(function(c){ %>
    <tr>
      <td><%= c.category %></td>
      <td class="num amount"><%= c.amountYuan %></td>
      <td class="num"><%= c.count %></td>
      <td>
        <div class="bar-row">
          <div class="bar-track"><div class="bar" style="width:<%= catMax ? Math.round(c.amount / catMax * 100) : 0 %>%"></div></div>
          <span class="bar-pct"><%= catTotal ? Math.round(c.amount / catTotal * 100) : 0 %>%</span>
        </div>
      </td>
    </tr>
    <% }) %>
  </table>
  </div>
  <% } %>
</div>

<div class="card">
  <h2>月度趋势</h2>
  <% if (trend.length === 0) { %><div class="empty">暂无数据</div><% } else { %>
  <% let tmax = 0; trend.forEach(function(t){ if (t.expense > tmax) tmax = t.expense; }); %>
  <div class="table-wrap">
  <table>
    <tr><th>月份</th><th class="num">收入</th><th class="num">支出</th><th style="width:40%">支出走势</th></tr>
    <% trend.forEach(function(t){ %>
    <tr>
      <td><%= t.month %></td>
      <td class="num amount income"><%= t.incomeYuan %></td>
      <td class="num amount expense"><%= t.expenseYuan %></td>
      <td>
        <div class="bar-row">
          <div class="bar-track"><div class="bar" style="width:<%= tmax ? Math.round(t.expense / tmax * 100) : 0 %>%"></div></div>
          <span class="bar-pct"><%= tmax ? Math.round(t.expense / tmax * 100) : 0 %>%</span>
        </div>
      </td>
    </tr>
    <% }) %>
  </table>
  </div>
  <% } %>
</div>

<% } %>
