<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
:root{
  --bg-top:#eef2fb; --bg-bottom:#f6f7fb; --card:#fff; --border:#e6eaf3; --text:#1c2333; --muted:#69748a;
  --primary:#2563eb; --primary-dark:#1d4fd8; --primary-soft:#eaf1fe;
  --green:#16a34a; --green-soft:#e8f7ee; --red:#dc2626; --red-soft:#fdecec;
  --amber:#b45309; --amber-soft:#fdf3e3; --blue:#1d4ed8; --blue-soft:#e8effd;
  --radius:14px; --radius-sm:9px;
  --shadow:0 1px 2px rgba(16,24,40,.05),0 4px 16px -4px rgba(16,24,40,.08);
  --shadow-hover:0 6px 24px -6px rgba(16,24,40,.14);
  /* 分类色 */
  --cat-餐饮:#f59e0b; --cat-交通:#3b82f6; --cat-购物:#a855f7; --cat-居住:#14b8a6;
  --cat-娱乐:#ec4899; --cat-医疗:#22c55e; --cat-教育:#eab308; --cat-人情:#ef4444; --cat-其他:#94a3b8;
}
*{box-sizing:border-box}
body{font-family:system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;margin:0;color:var(--text);line-height:1.55;background:linear-gradient(180deg,var(--bg-top),var(--bg-bottom)) fixed;min-height:100vh}
nav{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);box-shadow:0 1px 3px rgba(16,24,40,.05);display:flex;gap:2px;flex-wrap:wrap;align-items:center;padding:8px 16px}
nav .brand{font-weight:800;font-size:16px;color:var(--text);margin-right:10px;letter-spacing:.3px}
nav a{color:#475569;text-decoration:none;font-size:14px;padding:7px 13px;border-radius:10px;transition:all .15s;font-weight:500}
nav a:hover{background:var(--primary-soft);color:var(--primary)}
nav a.active{background:var(--primary);color:#fff}
nav a.active:hover{filter:brightness(1.05)}
nav .mode{margin-left:auto;font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;background:var(--blue-soft);color:var(--blue)}
main{max-width:940px;margin:0 auto;padding:22px 16px 52px}
h1{font-size:21px;margin:2px 0 16px;font-weight:800}
.card{position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px 18px 16px;margin-bottom:16px;box-shadow:var(--shadow);transition:box-shadow .18s,transform .18s;overflow:hidden}
.card:hover{box-shadow:var(--shadow-hover);transform:translateY(-1px)}
.card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),#60a5fa)}
.card.income::before{background:linear-gradient(90deg,var(--green),#4ade80)}
.card.expense::before{background:linear-gradient(90deg,var(--red),#f87171)}
.card h2{margin:0 0 14px;font-size:16px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
/* 概览统计条 */
.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:6px}
.stat{position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 14px 12px 20px;box-shadow:var(--shadow);overflow:hidden}
.stat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px}
.stat.income::before{background:var(--green)} .stat.expense::before{background:var(--red)} .stat.balance::before{background:var(--blue)} .stat.mom::before{background:var(--primary)}
.stat .label{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:5px}
.stat .value{font-size:20px;font-weight:800;margin-top:3px;font-variant-numeric:tabular-nums}
.up{color:var(--red)} .down{color:var(--green)}
table{width:100%;border-collapse:collapse;font-size:14px}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
th,td{padding:10px 12px;border-bottom:1px solid #eef1f7;text-align:left;vertical-align:middle}
table.sub{width:auto;min-width:100%;font-size:13px;margin:6px 0 2px;background:#fff;border:1px solid #eef1f7;border-radius:6px}
table.sub th,table.sub td{padding:4px 8px;border-bottom:1px solid #f0f2f7}
table.sub th{background:transparent;font-size:12px;font-weight:600}
table.sub tr:last-child th,table.sub tr:last-child td{border-bottom:none}
details summary{cursor:pointer;color:var(--primary);font-size:13px;user-select:none;list-style:none}
details summary::-webkit-details-marker{display:none}
details summary::before{content:'▸ ';color:var(--muted)}
details[open] summary::before{content:'▾ '}
details summary:hover{text-decoration:underline}
/* 操作列不换行；全宽明细展开行 */
td.td-actions{white-space:nowrap}
td.td-details details{width:100%}
td.td-details details summary{white-space:nowrap}
td.td-details table.sub{margin-top:8px}
th{color:var(--muted);font-weight:600;font-size:13px;white-space:nowrap;background:#fafbfe;border-bottom:2px solid var(--border)}
tbody tr:nth-child(even){background:#fafbfe}
tbody tr:hover{background:var(--primary-soft)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:700}
.badge.pending{background:var(--amber-soft);color:var(--amber)}
.badge.settled{background:var(--green-soft);color:var(--green)}
.amount{font-variant-numeric:tabular-nums;font-weight:700}
.income{color:var(--green)} .expense{color:var(--red)}
/* 分类彩点 + 文字 */
.cat{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.cat::before{content:"";width:9px;height:9px;border-radius:50%;flex:none}
.cat-餐饮::before{background:var(--cat-餐饮)} .cat-交通::before{background:var(--cat-交通)} .cat-购物::before{background:var(--cat-购物)}
.cat-居住::before{background:var(--cat-居住)} .cat-娱乐::before{background:var(--cat-娱乐)} .cat-医疗::before{background:var(--cat-医疗)}
.cat-教育::before{background:var(--cat-教育)} .cat-人情::before{background:var(--cat-人情)} .cat-其他::before{background:var(--cat-其他)}
/* 占比/走势条 */
.bar-row{display:flex;align-items:center;gap:8px}
.bar-track{flex:1;background:#eef1f7;border-radius:6px;height:10px;overflow:hidden}
.bar-track .bar{height:100%;min-width:0;border-radius:6px;background:linear-gradient(90deg,var(--primary),#60a5fa)}
.bar-pct{font-size:12px;color:var(--muted);min-width:44px;text-align:right;font-variant-numeric:tabular-nums}
/* 分类色渐变条（统计页用） */
.bar-track .bar.cat-bar{background:linear-gradient(90deg,currentColor,#d9e2ff)}
.cat-bar{color:var(--cat-餐饮)}
.cat-bar.cat-餐饮{color:var(--cat-餐饮)} .cat-bar.cat-交通{color:var(--cat-交通)} .cat-bar.cat-购物{color:var(--cat-购物)}
.cat-bar.cat-居住{color:var(--cat-居住)} .cat-bar.cat-娱乐{color:var(--cat-娱乐)} .cat-bar.cat-医疗{color:var(--cat-医疗)}
.cat-bar.cat-教育{color:var(--cat-教育)} .cat-bar.cat-人情{color:var(--cat-人情)} .cat-bar.cat-其他{color:var(--cat-其他)}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
input,select,button{padding:8px 12px;border:1px solid #cfd6e4;border-radius:var(--radius-sm);font-size:14px;font-family:inherit;background:#fff;color:var(--text)}
input:focus,select:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
button{background:linear-gradient(180deg,var(--primary),var(--primary-dark));color:#fff;border:none;cursor:pointer;font-weight:600;transition:all .15s}
button:hover{box-shadow:0 3px 10px -2px rgba(37,99,235,.4);filter:brightness(1.04)}
button.danger{background:linear-gradient(180deg,#ef4444,#dc2626)}
button.danger:hover{box-shadow:0 3px 10px -2px rgba(220,38,38,.4)}
button.ghost{background:#fff;color:var(--primary);border:1px solid var(--primary);font-weight:600}
button.ghost:hover{background:var(--primary-soft);box-shadow:none}
button.icon-btn{padding:8px 10px;line-height:1}
form.inline{display:inline;margin-right:4px}
.muted{color:var(--muted);font-size:13px}
.empty{padding:44px;text-align:center;color:var(--muted);font-size:15px}
.pager{margin-top:14px;font-size:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pager a{color:var(--primary);text-decoration:none;padding:6px 13px;border:1px solid var(--border);border-radius:var(--radius-sm);font-weight:500}
.pager a:hover{background:var(--primary-soft);border-color:var(--primary)}
.error{background:var(--red-soft);color:var(--red);border:1px solid #f5c6cb;border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:14px;font-weight:500}
/* 总览：每账本三段式（日常 / 工作 / 代办） */
.seg{margin-top:14px;padding-top:14px;border-top:1px dashed var(--border)}
.seg:first-of-type{margin-top:4px;padding-top:0;border-top:none}
.seg h3{margin:0 0 10px;font-size:14px;font-weight:700;color:var(--muted);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
a.btn{display:inline-block;text-decoration:none;font-size:14px;font-weight:600;padding:7px 13px;border-radius:var(--radius-sm);border:1px solid var(--primary);color:var(--primary);background:#fff;transition:all .15s;white-space:nowrap}
a.btn:hover{background:var(--primary-soft)}
a.btn.danger{border-color:var(--red);color:var(--red)}
a.btn.danger:hover{background:var(--red-soft)}
a.btn.right{margin-left:auto}
a.btn.icon{padding:7px 10px;line-height:1}
/* 表单分组（工作账单新建/编辑用） */
.form-section{margin:0 0 18px}
.form-section-title{font-size:14px;font-weight:800;margin:0 0 12px;padding-bottom:8px;border-bottom:2px solid var(--border);display:flex;align-items:center;gap:8px}
.form-section-title::before{content:"";width:4px;height:14px;background:var(--primary);border-radius:2px;flex:none}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px 12px}
.field{display:flex;flex-direction:column;gap:5px}
.field>span{font-size:12px;font-weight:600;color:var(--muted)}
.field input,.field select{width:100%}
.item-card{border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;margin-bottom:12px;background:#fbfcff}
.item-card-title{font-size:12px;font-weight:800;color:var(--muted);margin:0 0 10px;display:flex;align-items:center;gap:6px}
.item-card-title::before{content:"";width:8px;height:8px;border-radius:2px;background:var(--primary);flex:none}
.form-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
/* 移动端 */
@media (max-width:640px){
  nav{padding:8px 10px;gap:2px}
  nav .brand{width:100%;margin-bottom:2px}
  main{padding:14px 10px 40px}
  h1{font-size:19px}
  .card{padding:14px}
  .stat-row{grid-template-columns:repeat(2,1fr);gap:8px}
  .stat{padding:10px 10px 10px 16px}
  .stat .value{font-size:17px}
  .toolbar{gap:6px}
  .toolbar input,.toolbar select,.toolbar button{flex:1 1 auto;min-width:0}
  button{white-space:nowrap}
  /* 表格 → 卡片（仅带 .card-list 的列表表） */
  table.card-list{display:block}
  table.card-list thead{display:none}
  table.card-list tbody{display:block}
  table.card-list>tbody>tr{display:grid;grid-template-columns:repeat(2,1fr);gap:3px 12px;padding:12px;margin:0 0 12px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
  table.card-list>tbody>tr:nth-child(even){background:var(--card)}
  table.card-list>tbody>tr:hover{background:var(--card)}
  table.card-list td{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:2px 0;border:none;font-size:13px}
  table.card-list td::before{content:attr(data-label);color:var(--muted);font-size:12px;font-weight:600;flex:none}
  table.card-list td.num{text-align:left}
  table.card-list td.td-actions{grid-column:1 / -1;display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding-top:8px;margin-top:6px;border-top:1px dashed var(--border)}
  table.card-list td.td-actions::before{display:none}
  /* 全宽明细展开行：移动端压成卡片下方的展开条 */
  table.card-list>tbody>tr.bill-detail-row{display:block;padding:0;margin:-4px 0 12px;background:transparent;border:none;box-shadow:none}
  table.card-list>tbody>tr.bill-detail-row:hover{background:transparent}
  table.card-list>tbody>tr.bill-detail-row>td{display:block;padding:0;border:none}
  table.card-list>tbody>tr.bill-detail-row>td::before{display:none}
  table.card-list>tbody>tr.bill-detail-row details{width:100%}
  table.card-list>tbody>tr.bill-detail-row summary{display:inline-block;padding:2px 0;font-size:13px}
  /* 明细子表 → 卡片 */
  table.sub{min-width:0;background:transparent;border:none}
  table.sub thead{display:none}
  table.sub tbody{display:block}
  table.sub>tbody>tr{display:grid;grid-template-columns:repeat(2,1fr);gap:3px 10px;padding:8px 10px;margin:6px 0;background:var(--bg-bottom);border:1px solid var(--border);border-radius:var(--radius-sm)}
  table.sub td{display:flex;justify-content:space-between;gap:8px;border:none;padding:2px 0;font-size:12.5px}
  table.sub td::before{content:attr(data-label);color:var(--muted);font-size:12px;font-weight:600;flex:none}
}
</style>
</head>
<body>
<nav>
  <span class="brand">🏠 家庭账本</span>
  <a href="/w/<%= token %>" data-nav="home" class="<%= active === 'home' ? 'active' : '' %>">📊 总览</a>
  <a href="/w/<%= token %>/bills<%= accountId > 0 ? '?account_id=' + accountId : '' %>" data-nav="bills" class="<%= active === 'bills' ? 'active' : '' %>">🧾 账单</a>
  <a href="/w/<%= token %>/tasks<%= accountId > 0 ? '?account_id=' + accountId : '' %>" data-nav="tasks" class="<%= active === 'tasks' ? 'active' : '' %>">✅ 待办</a>
  <a href="/w/<%= token %>/stats<%= accountId > 0 ? '?account_id=' + accountId : '' %>" data-nav="stats" class="<%= active === 'stats' ? 'active' : '' %>">📈 统计</a>
  <a href="/w/<%= token %>/trash<%= accountId > 0 ? '?account_id=' + accountId : '' %>" data-nav="trash" class="<%= active === 'trash' ? 'active' : '' %>">🗑️ 回收站</a>
  <span class="mode"><%= mode === 'write' ? '✏️ 可写' : '👁️ 只读' %></span>
</nav>
<main><%- body %></main>
<script>
/* 保留状态：action 表单（data-keep）提交后原地刷新，保留当前 URL 的筛选参数与滚动位置。
   注意：模板在进程启动时编译一次，改动 layout/work 等 .ejs 后需重启 dev 进程（tsx watch 不监听 .ejs）。 */
(function () {
  var KEY = 'keep-scroll';
  function saved() {
    try { var s = sessionStorage.getItem(KEY); return s === null ? null : (Number(s) || 0); } catch (e) { return null; }
  }
  var y = saved();
  if (y !== null) {
    window.scrollTo(0, y);                       // 立即恢复
    window.addEventListener('load', function () { // 布局定稿后再滚一次并清除标记
      try { sessionStorage.removeItem(KEY); } catch (e) {}
      window.scrollTo(0, y);
    });
  }
  document.addEventListener('submit', function (ev) {
    var f = ev.target;
    if (!f || !f.matches || !f.matches('form[data-keep]')) return;
    if (typeof f.checkValidity === 'function' && !f.checkValidity()) { f.reportValidity(); ev.preventDefault(); return; }
    ev.preventDefault();
    var py = window.pageYOffset !== undefined ? window.pageYOffset : document.documentElement.scrollTop;
    try { sessionStorage.setItem(KEY, String(py || 0)); } catch (e) {}
    fetch(f.action, { method: 'POST', body: new URLSearchParams(new FormData(f)), headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, redirect: 'manual' })
      .catch(function () {})
      .then(function () { window.location.reload(); });
  });
})();
</script>
</body>
</html>
