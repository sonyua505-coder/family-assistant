<h1>📊 待办统计</h1>

<% if (accounts.length === 0) { %>
  <div class="empty">还没有账本。</div>
<% } else { %>

<form class="toolbar" method="get" action="/w/<%= token %>/tasks/stats">
  <select name="account_id"><%- opt(accounts, accountId, 'task') %></select>
  <button>查看</button>
</form>

<div class="stat-row">
  <div class="stat balance"><div class="label">📋 全部</div><div class="value"><%= total %></div></div>
  <div class="stat mom"><div class="label">🕐 未完成</div><div class="value"><%= undone %></div></div>
  <div class="stat income"><div class="label">✅ 已完成</div><div class="value"><%= done %></div></div>
  <div class="stat expense"><div class="label">🎯 完成率</div><div class="value"><%= doneRate %>%</div></div>
</div>

<div class="card">
  <h2>📂 按分类</h2>
  <% if (byCategory.length === 0) { %><div class="empty">暂无数据</div><% } else { %>
  <% let catMax = 0; byCategory.forEach(function(c){ if (c.count > catMax) catMax = c.count; }); %>
  <div class="table-wrap">
  <table>
    <tr><th>分类</th><th class="num">条数</th><th class="num">已完成</th><th style="width:45%">完成率</th></tr>
    <% byCategory.forEach(function(c){ %>
    <tr>
      <td><%= c.category %></td>
      <td class="num"><%= c.count %></td>
      <td class="num income"><%= c.done %></td>
      <td>
        <div class="bar-row">
          <div class="bar-track"><div class="bar" style="width:<%= c.count ? Math.round(c.done / c.count * 100) : 0 %>%"></div></div>
          <span class="bar-pct"><%= c.count ? Math.round(c.done / c.count * 100) : 0 %>%</span>
        </div>
      </td>
    </tr>
    <% }) %>
  </table>
  </div>
  <% } %>
</div>

<% } %>
