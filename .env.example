# 复制为 .env 后按需修改；.env 不提交 git（X_API_KEY 只存在于服务器 .env）

# API 服务端口（容器内 / 本地）
API_PORT=3000
# 记账 Web 服务端口（绑定 ZT_IP，不暴露公网）
WEB_PORT=8081

# SQLite 数据库路径
DB_PATH=./data/dev.db

# 服务间共享密钥（AstrBot 插件配置用；本地随便，服务器随机生成）
X_API_KEY=change-me-local-x-api-key

# 内部管理接口（表注册）管理员密钥，区别于 X_API_KEY
ADMIN_KEY=change-me-local-admin-key

# 时区
TZ=Asia/Shanghai

# 记账 Web 链接基础 URL（本地开发绑 127.0.0.1；服务器=ZeroTier IP）
ZT_IP=127.0.0.1
PUBLIC_WEB_BASE=http://127.0.0.1:8081
