<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
body{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;margin:0;background:#f5f6f8;color:#222}
nav{background:#fff;padding:10px 16px;border-bottom:1px solid #e3e4e8;display:flex;gap:16px;flex-wrap:wrap;align-items:center}
nav a{color:#2563eb;text-decoration:none;font-size:14px}
nav .mode{color:#888;font-size:12px;margin-left:auto}
main{max-width:880px;margin:16px auto;padding:0 16px 40px}
h1{font-size:20px;margin:8px 0 14px}
.card{background:#fff;border:1px solid #e3e4e8;border-radius:10px;padding:16px;margin-bottom:14px}
.card h2{margin:0 0 10px;font-size:16px}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:7px 8px;border-bottom:1px solid #f0f0f0;text-align:left;vertical-align:middle}
th{color:#666;font-weight:600}
.badge{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px}
.badge.pending{background:#fff3cd;color:#8a6d00}
.badge.settled{background:#e6f4ea;color:#1a7f37}
.amount{font-variant-numeric:tabular-nums;font-weight:600}
.income{color:#1a7f37}.expense{color:#c62828}
.bar{background:#2563eb;height:10px;border-radius:5px;min-width:2px}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
input,select,button{padding:6px 10px;border:1px solid #ccc;border-radius:6px;font-size:14px;font-family:inherit;box-sizing:border-box}
button{background:#2563eb;color:#fff;border:none;cursor:pointer}
button.danger{background:#c62828}
button.ghost{background:#fff;color:#2563eb;border:1px solid #2563eb}
form.inline{display:inline;margin-right:4px}
.muted{color:#888;font-size:13px}
.empty{padding:40px;text-align:center;color:#999}
.pager{margin-top:10px;font-size:14px}
.pager a{margin:0 6px;color:#2563eb}
.error{background:#fdecea;color:#b71c1c;border:1px solid #f5c6cb;border-radius:8px;padding:10px 14px;margin-bottom:12px}
</style>
</head>
<body>
<nav>
  <a href="/w/<%= token %>">总览</a>
  <a href="/w/<%= token %>/bills">账单</a>
  <a href="/w/<%= token %>/stats">统计</a>
  <a href="/w/<%= token %>/aa">待收</a>
  <a href="/w/<%= token %>/trash">回收站</a>
  <a href="/w/<%= token %>/export">导出CSV</a>
  <span class="mode"><%= mode === 'write' ? '可写令牌' : '只读令牌' %></span>
</nav>
<main><%- body %></main>
</body>
</html>
