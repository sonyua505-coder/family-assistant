<h1><%= trash ? '回收站 · 待办' : '待办' %></h1>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<% if (accounts.length === 0) { %>
  <div class="empty">还没有账本。</div>
<% } else if (trash) { %>

<%- switcher({ token: token, action: '/w/' + token + '/tasks', accounts: accounts, accountId: accountId, hidden: { trash: '1' }, links: [
  { href: '/w/' + token + '/tasks/stats?account_id=' + accountId, label: '📊 统计' },
  { href: '/w/' + token + '/tasks/export?account_id=' + accountId, label: '⬇️ 导出' },
  { href: '/w/' + token + '/tasks?account_id=' + accountId, label: '⬅ 返回待办', className: 'right' },
] }) %>

<% } else { %>

<form class="toolbar" method="get" action="/w/<%= token %>/tasks">
  <select name="account_id"><%- opt(accounts, accountId) %></select>
  <select name="status">
    <option value="">全部状态</option>
    <option value="undone" <%= status === 'undone' ? 'selected' : '' %>>未完成</option>
    <option value="done" <%= status === 'done' ? 'selected' : '' %>>已完成</option>
  </select>
  <select name="category">
    <option value="">全部分类</option>
    <% taskCats.forEach(function(c){ %>
      <option value="<%= c %>" <%= c === category ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <input type="text" name="q" value="<%= q %>" placeholder="关键词（内容）">
  <button>筛选</button>
</form>

<p class="muted" style="margin:0 0 14px">
  <a class="btn" href="/w/<%= token %>/tasks/stats?account_id=<%= accountId %>">📊 统计</a>
  <a class="btn" href="<%= exportHref %>">⬇️ 导出当前筛选 CSV</a>
  <a class="btn" href="/w/<%= token %>/trash?account_id=<%= accountId %>&kind=task">🗑️ 回收站</a>
</p>

<% if (mode === 'write') { %>
<div class="card">
  <h2>新增待办</h2>
  <form method="post" action="/w/<%= token %>/tasks">
    <input type="hidden" name="account_id" value="<%= accountId %>">
    <div class="toolbar">
      <input type="text" name="content" placeholder="内容" required>
      <input type="text" name="category" list="taskCatList" placeholder="分类（可选，可输入新分类）">
      <datalist id="taskCatList">
        <% taskCats.forEach(function(c){ %><option value="<%= c %>"><% }) %>
      </datalist>
      <input type="text" name="remind_at" placeholder="提醒：YYYY-MM-DD 或 YYYY-MM-DD HH:MM">
      <button>新增</button>
    </div>
  </form>
</div>
<% } %>

<% } %>

<% if (items.length === 0) { %>
  <div class="empty"><%= trash ? '回收站为空。' : '暂无待办' %></div>
<% } else if (trash) { %>
<div class="table-wrap">
<table>
<tr><th>内容</th><th>分类</th><th>删除时间</th><% if (mode === 'write') { %><th>操作</th><% } %></tr>
<% items.forEach(function(t){ %>
<tr>
  <td><%= t.content %></td>
  <td class="muted"><%= t.category %></td>
  <td class="muted" style="white-space:nowrap"><%= t.deleted_at %></td>
  <% if (mode === 'write') { %>
  <td style="white-space:nowrap">
    <form class="inline" method="post" action="/w/<%= token %>/tasks/<%= t.id %>/restore"><button>♻️ 恢复</button></form>
    <form class="inline" method="post" action="/w/<%= token %>/tasks/<%= t.id %>/purge"><button class="danger" title="彻底删除（不可恢复）">🗑️ 彻底删</button></form>
  </td>
  <% } %>
</tr>
<% }) %>
</table>
</div>
<% } else { %>
<div class="table-wrap">
<table>
<tr><th>状态</th><th>内容</th><th>分类</th><th>提醒</th><% if (mode === 'write') { %><th>操作</th><% } %></tr>
<% items.forEach(function(t){ %>
<tr>
  <td style="white-space:nowrap"><span class="badge <%= t.is_done ? 'settled' : 'pending' %>"><%= t.is_done ? '✅ 已完成' : '🕐 未完成' %></span></td>
  <td><%= t.content %></td>
  <td class="muted"><%= t.category %></td>
  <td class="muted" style="white-space:nowrap"><%= t.remind_at %></td>
  <% if (mode === 'write') { %>
  <td style="white-space:nowrap">
    <a class="btn icon" href="/w/<%= token %>/tasks/<%= t.id %>/edit" title="编辑">✏️</a>
    <% if (!t.is_done) { %>
      <form class="inline" method="post" action="/w/<%= token %>/tasks/<%= t.id %>/done"><button title="完成">✅ 完成</button></form>
    <% } else { %>
      <form class="inline" method="post" action="/w/<%= token %>/tasks/<%= t.id %>/undo"><button class="ghost" title="改回未完成">↩️</button></form>
    <% } %>
    <form class="inline" method="post" action="/w/<%= token %>/tasks/<%= t.id %>/delete"><button class="danger" title="删除">🗑️</button></form>
  </td>
  <% } %>
</tr>
<% }) %>
</table>
</div>
<div class="muted">共 <%= total %> 条待办（未完成在前）</div>
<% } %>
