<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
:root{
  --bg-top:#eef2fb; --bg-bottom:#f6f7fb; --card:#fff; --border:#e6eaf3; --text:#1c2333; --muted:#69748a;
  --primary:#2563eb; --primary-dark:#1d4fd8; --primary-soft:#eaf1fe;
  --green:#16a34a; --green-soft:#e8f7ee; --red:#dc2626; --red-soft:#fdecec;
  --amber:#b45309; --amber-soft:#fdf3e3; --blue:#1d4ed8; --blue-soft:#e8effd;
  --radius:14px; --radius-sm:9px;
  --shadow:0 1px 2px rgba(16,24,40,.05),0 4px 16px -4px rgba(16,24,40,.08);
  --shadow-hover:0 6px 24px -6px rgba(16,24,40,.14);
  /* 分类色 */
  --cat-餐饮:#f59e0b; --cat-交通:#3b82f6; --cat-购物:#a855f7; --cat-居住:#14b8a6;
  --cat-娱乐:#ec4899; --cat-医疗:#22c55e; --cat-教育:#eab308; --cat-人情:#ef4444; --cat-其他:#94a3b8;
}
*{box-sizing:border-box}
body{font-family:system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;margin:0;color:var(--text);line-height:1.55;background:linear-gradient(180deg,var(--bg-top),var(--bg-bottom)) fixed;min-height:100vh}
nav{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);box-shadow:0 1px 3px rgba(16,24,40,.05);display:flex;gap:2px;flex-wrap:wrap;align-items:center;padding:8px 16px}
nav .brand{font-weight:800;font-size:16px;color:var(--text);margin-right:10px;letter-spacing:.3px}
nav a{color:#475569;text-decoration:none;font-size:14px;padding:7px 13px;border-radius:10px;transition:all .15s;font-weight:500}
nav a:hover{background:var(--primary-soft);color:var(--primary)}
nav .mode{margin-left:auto;font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;background:var(--blue-soft);color:var(--blue)}
main{max-width:940px;margin:0 auto;padding:22px 16px 52px}
h1{font-size:21px;margin:2px 0 16px;font-weight:800}
.card{position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px 18px 16px;margin-bottom:16px;box-shadow:var(--shadow);transition:box-shadow .18s,transform .18s;overflow:hidden}
.card:hover{box-shadow:var(--shadow-hover);transform:translateY(-1px)}
.card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),#60a5fa)}
.card.income::before{background:linear-gradient(90deg,var(--green),#4ade80)}
.card.expense::before{background:linear-gradient(90deg,var(--red),#f87171)}
.card h2{margin:0 0 14px;font-size:16px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
/* 概览统计条 */
.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:6px}
.stat{position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 14px 12px 20px;box-shadow:var(--shadow);overflow:hidden}
.stat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px}
.stat.income::before{background:var(--green)} .stat.expense::before{background:var(--red)} .stat.balance::before{background:var(--blue)} .stat.mom::before{background:var(--primary)}
.stat .label{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:5px}
.stat .value{font-size:20px;font-weight:800;margin-top:3px;font-variant-numeric:tabular-nums}
.up{color:var(--red)} .down{color:var(--green)}
table{width:100%;border-collapse:collapse;font-size:14px}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
th,td{padding:10px 12px;border-bottom:1px solid #eef1f7;text-align:left;vertical-align:middle}
th{color:var(--muted);font-weight:600;font-size:13px;white-space:nowrap;background:#fafbfe;border-bottom:2px solid var(--border)}
tbody tr:nth-child(even){background:#fafbfe}
tbody tr:hover{background:var(--primary-soft)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:700}
.badge.pending{background:var(--amber-soft);color:var(--amber)}
.badge.settled{background:var(--green-soft);color:var(--green)}
.amount{font-variant-numeric:tabular-nums;font-weight:700}
.income{color:var(--green)} .expense{color:var(--red)}
/* 分类彩点 + 文字 */
.cat{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.cat::before{content:"";width:9px;height:9px;border-radius:50%;flex:none}
.cat-餐饮::before{background:var(--cat-餐饮)} .cat-交通::before{background:var(--cat-交通)} .cat-购物::before{background:var(--cat-购物)}
.cat-居住::before{background:var(--cat-居住)} .cat-娱乐::before{background:var(--cat-娱乐)} .cat-医疗::before{background:var(--cat-医疗)}
.cat-教育::before{background:var(--cat-教育)} .cat-人情::before{background:var(--cat-人情)} .cat-其他::before{background:var(--cat-其他)}
/* 占比/走势条 */
.bar-row{display:flex;align-items:center;gap:8px}
.bar-track{flex:1;background:#eef1f7;border-radius:6px;height:10px;overflow:hidden}
.bar-track .bar{height:100%;min-width:0;border-radius:6px;background:linear-gradient(90deg,var(--primary),#60a5fa)}
.bar-pct{font-size:12px;color:var(--muted);min-width:44px;text-align:right;font-variant-numeric:tabular-nums}
/* 分类色渐变条（统计页用） */
.bar-track .bar.cat-bar{background:linear-gradient(90deg,currentColor,#d9e2ff)}
.cat-bar{color:var(--cat-餐饮)}
.cat-bar.cat-餐饮{color:var(--cat-餐饮)} .cat-bar.cat-交通{color:var(--cat-交通)} .cat-bar.cat-购物{color:var(--cat-购物)}
.cat-bar.cat-居住{color:var(--cat-居住)} .cat-bar.cat-娱乐{color:var(--cat-娱乐)} .cat-bar.cat-医疗{color:var(--cat-医疗)}
.cat-bar.cat-教育{color:var(--cat-教育)} .cat-bar.cat-人情{color:var(--cat-人情)} .cat-bar.cat-其他{color:var(--cat-其他)}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
input,select,button{padding:8px 12px;border:1px solid #cfd6e4;border-radius:var(--radius-sm);font-size:14px;font-family:inherit;background:#fff;color:var(--text)}
input:focus,select:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
button{background:linear-gradient(180deg,var(--primary),var(--primary-dark));color:#fff;border:none;cursor:pointer;font-weight:600;transition:all .15s}
button:hover{box-shadow:0 3px 10px -2px rgba(37,99,235,.4);filter:brightness(1.04)}
button.danger{background:linear-gradient(180deg,#ef4444,#dc2626)}
button.danger:hover{box-shadow:0 3px 10px -2px rgba(220,38,38,.4)}
button.ghost{background:#fff;color:var(--primary);border:1px solid var(--primary);font-weight:600}
button.ghost:hover{background:var(--primary-soft);box-shadow:none}
button.icon-btn{padding:8px 10px;line-height:1}
form.inline{display:inline;margin-right:4px}
.muted{color:var(--muted);font-size:13px}
.empty{padding:44px;text-align:center;color:var(--muted);font-size:15px}
.pager{margin-top:14px;font-size:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pager a{color:var(--primary);text-decoration:none;padding:6px 13px;border:1px solid var(--border);border-radius:var(--radius-sm);font-weight:500}
.pager a:hover{background:var(--primary-soft);border-color:var(--primary)}
.error{background:var(--red-soft);color:var(--red);border:1px solid #f5c6cb;border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:14px;font-weight:500}
/* 移动端 */
@media (max-width:640px){
  nav{padding:8px 10px;gap:2px}
  nav .brand{width:100%;margin-bottom:2px}
  main{padding:14px 10px 40px}
  h1{font-size:19px}
  .card{padding:14px}
  .stat-row{grid-template-columns:repeat(2,1fr);gap:8px}
  .stat{padding:10px 10px 10px 16px}
  .stat .value{font-size:17px}
  .toolbar{gap:6px}
  .toolbar input,.toolbar select,.toolbar button{flex:1 1 auto;min-width:0}
  button{white-space:nowrap}
}
</style>
</head>
<body>
<nav>
  <span class="brand">🏠 家庭账本</span>
  <a href="/w/<%= token %>">📊 总览</a>
  <a href="/w/<%= token %>/bills<%= accountId > 0 ? '?account_id=' + accountId : '' %>">🧾 账单</a>
  <a href="/w/<%= token %>/tasks<%= accountId > 0 ? '?account_id=' + accountId : '' %>">✅ 待办</a>
  <a href="/w/<%= token %>/work<%= accountId > 0 ? '?account_id=' + accountId : '' %>">🔨 工作</a>
  <a href="/w/<%= token %>/stats<%= accountId > 0 ? '?account_id=' + accountId : '' %>">📈 统计</a>
  <a href="/w/<%= token %>/aa<%= accountId > 0 ? '?account_id=' + accountId : '' %>">💰 待收</a>
  <a href="/w/<%= token %>/trash<%= accountId > 0 ? '?account_id=' + accountId : '' %>">🗑️ 回收站</a>
  <a href="/w/<%= token %>/export<%= accountId > 0 ? '?account_id=' + accountId : '' %>">⬇️ 导出</a>
  <span class="mode"><%= mode === 'write' ? '✏️ 可写' : '👁️ 只读' %></span>
</nav>
<main><%- body %></main>
</body>
</html>
