<h1>📊 账本总览</h1>
<% if (accounts.length === 0) { %>
  <div class="empty">还没有账本。请先在机器人里创建账本（家庭 / 个人），再回来查看。</div>
<% } else { %>
  <% accounts.forEach(function(a){ %>
    <div class="card">
      <h2><%= a.name %>
        <span class="badge <%= a.type === 'family' ? 'settled' : 'pending' %>"><%= a.type === 'family' ? '👨‍👩‍👧 家庭' : '👤 个人' %></span>
        <span class="muted">（<%= a.role %>）</span>
      </h2>

      <div class="stat-row">
        <div class="stat income">
          <div class="label">💸 本月收入</div>
          <div class="value income"><%= a.income %> 元</div>
        </div>
        <div class="stat expense">
          <div class="label">🧾 本月支出</div>
          <div class="value expense"><%= a.expense %> 元</div>
        </div>
        <div class="stat balance">
          <div class="label">💰 本月结余</div>
          <div class="value <%= a.balanceClass %>"><%= a.balance %> 元</div>
        </div>
        <div class="stat mom">
          <div class="label">📈 支出环比上月</div>
          <div class="value <%= a.momClass %>"><%= a.momClass === 'up' ? '▲' : (a.momClass === 'down' ? '▼' : '') %> <%= a.momText %></div>
        </div>
        <div class="stat mom">
          <div class="label">✅ 未完成待办</div>
          <div class="value"><%= a.pendingTasks %></div>
        </div>
        <div class="stat mom">
          <div class="label">🔨 工作欠款</div>
          <div class="value <%= a.workOwedClass %>"><%= a.workOwed %> 元</div>
        </div>
      </div>

      <% if (a.topCategories.length > 0) { %>
      <div class="muted" style="margin:10px 0 6px">本月支出 Top：
        <% a.topCategories.forEach(function(c, i){ %>
          <span class="cat cat-<%= c.category %>"><%= c.category %> <b><%= c.amountYuan %></b>元</span><%= i < a.topCategories.length - 1 ? '、' : '' %>
        <% }) %>
      </div>
      <% } %>

      <div class="toolbar">
        <a href="/w/<%= token %>/bills?account_id=<%= a.id %>"><button class="ghost">🧾 账单</button></a>
        <a href="/w/<%= token %>/tasks?account_id=<%= a.id %>"><button class="ghost">✅ 待办</button></a>
        <a href="/w/<%= token %>/work?account_id=<%= a.id %>"><button class="ghost">🔨 工作</button></a>
        <a href="/w/<%= token %>/stats?account_id=<%= a.id %>"><button class="ghost">📈 统计</button></a>
        <a href="/w/<%= token %>/aa?account_id=<%= a.id %>"><button class="ghost">💰 待收</button></a>
        <a href="/w/<%= token %>/export?account_id=<%= a.id %>"><button class="ghost">⬇️ 导出</button></a>
      </div>
    </div>
  <% }) %>
<% } %>
