# 服务器 .env 模板 —— 复制为 /opt/homeassistant/.env 后编辑（.env 不提交 git）

# ── 密钥（服务器上随机生成，务必改掉）──
# 生成：openssl rand -hex 32
X_API_KEY=change-me-server-x-api-key
ADMIN_KEY=change-me-server-admin-key

# ── 记账 Web 链接（ZeroTier 访问）──
# ZT_IP：ZeroTier 控制台给服务器分配的固定内网 IP，如 10.147.17.x
# PUBLIC_WEB_BASE：铸造记账链接用的基础 URL（家人经 ZeroTier 打开）
ZT_IP=127.0.0.1
PUBLIC_WEB_BASE=http://127.0.0.1:8081

# ── 可选 ──
# LOG_LEVEL=info
